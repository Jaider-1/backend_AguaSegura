{
  "name": "aguasegura-backend",
  "version": "1.0.0",
  "description": "Backend para sistema de gestión de agua",
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "db:init": "npm run db:migrate && npm run db:seed",
    "db:migrate": "ts-node database/scripts/run-migrations.ts",
    "db:seed": "ts-node database/scripts/run-seeders.ts",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "migration:generate": "typeorm migration:generate -d database/data-source.ts",
    "migration:create": "typeorm migration:create database/migrations/NombreMigracion",
    "migration:run": "typeorm migration:run -d database/data-source.ts",
    "migration:revert": "typeorm migration:revert -d database/data-source.ts",
    "seed:run": "ts-node database/scripts/run-seeders.ts",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "lint:report": "eslint \"{src,test}/**/*.ts\" --format=json --output-file=eslint-report.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit --strict",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "audit": "npm audit --audit-level=high",
    "outdated": "npm outdated",
    "ci:full": "npm run typecheck && npm run format:check && npm run lint:check && npm run test:cov",
    "clean": "rm -rf dist coverage .nyc_output",
    "reset": "npm run clean && rm -rf node_modules && npm install"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.4.20",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "cross-spawn": "^7.0.5",
    "csv-parser": "^3.2.0",
    "express": "^4.16.0",
    "glob": "^10.5.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.11.0",
    "typeorm": "^0.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.0",
    "@types/node": "^18.19.130",
    "@types/passport-jwt": "^3.0.13",
    "@types/passport-local": "^1.0.0",
    "eslint": "^9.39.2",
    "express": "^4.21.1",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
