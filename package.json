{
  "name": "aguasegura-backend",
  "version": "1.0.0",
  "description": "Backend para sistema de gestión de agua",
  "engines": {
    "node": "20.x",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "prebuild": "node -v",
    "build": "nest build",
    "start:dev": "nest start --watch",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "seed": "ts-node database/scripts/run-seeders.ts",
    "seed:dev": "nodemon --watch database --ext ts --exec npm run seed",
    "docker:db": "docker-compose up postgres -d",
    "dev": "npm run docker:db && nest start --watch",
    "dev:full": "npm run docker:db && nest start --watch & npm run seed:dev",
    "db:init": "npm run db:migrate && npm run db:seed",
    "db:migrate": "ts-node database/scripts/run-migrations.ts",
    "db:seed": "ts-node database/scripts/run-seeders.ts",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "migration:generate": "typeorm migration:generate -d database/data-source.ts",
    "migration:create": "typeorm migration:create database/migrations/NombreMigracion",
    "migration:run": "typeorm migration:run -d database/data-source.ts",
    "migration:revert": "typeorm migration:revert -d database/data-source.ts",
    "seed:run": "ts-node database/scripts/run-seeders.ts",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit --strict",
    "audit": "npm audit --audit-level=high",
    "outdated": "npm outdated",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "health:e2e": "node scripts/e2e-health-check.js",
    "install:ci": "npm install --legacy-peer-deps --no-audit",
    "clean": "rm -rf dist coverage .nyc_output",
    "reset": "npm run clean && rm -rf node_modules && npm install --legacy-peer-deps"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.12",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.12",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/typeorm": "^11.0.0",
    "@types/multer": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "csv-parse": "^6.1.0",
    "csv-parser": "^3.2.0",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.17.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@types/bcryptjs": "^3.0.0",
    "@types/csv-parse": "^1.1.12",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.10",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "js-yaml": "4.1.1",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "js-yaml": "4.1.1"
  }
}
