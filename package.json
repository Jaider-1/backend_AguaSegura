{
  "name": "aguasegura-backend",
  "version": "1.0.0",
  "description": "Backend para sistema de gestión de agua",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "docker:dev": "docker-compose up --build",
    "docker:down": "docker-compose down",
    "docker:clean": "docker-compose down -v --remove-orphans",
    "db:logs": "docker logs aguasegura-db -f",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed": "ts-node database/scripts/run-seeders.ts",
    "seed:recommendations": "ts-node database/seeds/recommendations.seed.ts",
    "typeorm": "ts-node ./node_modules/typeorm/cli",
    "migration:generate": "typeorm migration:generate -d ./database/data-source-cjs.ts -o ./database/migrations/",
    "migration:run": "typeorm migration:run -d ./database/data-source-cjs.ts",
    "migration:revert": "typeorm migration:revert -d ./database/data-source-cjs.ts",
    "migration:create": "typeorm migration:create ./database/migrations/NombreMigracion",
    "migration:run:config": "typeorm migration:run",
    "migration:generate:config": "typeorm migration:generate -n",
    "seed:run": "ts-node database/scripts/run-seeders.ts",
    "db:reset": "npm run migration:revert && npm run migration:run && npm run seed:run"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.4.20",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "csv-parser": "^3.2.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.11.0",
    "typeorm": "^0.3.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.0",
    "@types/node": "^18.19.130",
    "@types/passport-jwt": "^3.0.13",
    "@types/passport-local": "^1.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
