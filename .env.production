NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://tu-frontend.onrender.com

# Prefer DATABASE_URL in production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# Fallback database settings if DATABASE_URL is not used
# Valores de fallback para usar si no se usa `DATABASE_URL`.
# En Render puedes rellenar estos con las credenciales que genera el servicio de DB.
DB_HOST=RENDER_DB_HOST
DB_PORT=5432
DB_USERNAME=RENDER_DB_USERNAME
DB_PASSWORD=RENDER_DB_PASSWORD
DB_DATABASE=RENDER_DB_NAME
DB_SYNCHRONIZE=false

# Security
JWT_SECRET=REPLACE_WITH_STRONG_SECRET
