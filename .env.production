NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://tu-frontend.onrender.com

# Prefer DATABASE_URL in production. Set the real Render connection string in the dashboard.
DATABASE_URL=

# Fallback database settings if DATABASE_URL is not used
# En producción, deja estos campos vacíos si no vas a usar las credenciales manuales.
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_SYNCHRONIZE=false

# Security
JWT_SECRET=REPLACE_WITH_STRONG_SECRET
